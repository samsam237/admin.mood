NODE_ENV=production
PORT=3050

# Neon PostgreSQL — https://neon.tech (projet gratuit suffit)
# "Pooled connection" (pour l'app runtime)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.neon.tech/dbname?sslmode=require
# "Direct connection" (pour prisma migrate uniquement)
DIRECT_URL=postgresql://user:pass@ep-xxx.region.neon.tech/dbname?sslmode=require

# Auth admin dashboard
JWT_SECRET=changeme-minimum-32-chars-required
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Sauvegardes fichiers utilisateurs (dans le volume Docker)
USER_BACKUP_DIR=/app/data/user_backups
BACKUP_RETENTION_DAYS=30
